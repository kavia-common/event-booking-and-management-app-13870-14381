# NotificationService environment variables

# FastAPI/uvicorn settings
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Email providers (set one of these to enable a named provider; otherwise stub is used)
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SMS providers (set to enable twilio; otherwise stub is used)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
